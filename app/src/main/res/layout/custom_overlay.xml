<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#AA000000">

    <FrameLayout
        android:id="@+id/centerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:background="@drawable/rounded_corners">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kabukabu Driver"
            android:textSize="12sp"
            android:textFontWeight="500"
            android:textColor="@android:color/black"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:gravity="center"/>
        <TextView
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You have a trip request!"
            android:textSize="18sp"
            android:textFontWeight="500"
            android:textColor="@android:color/black"
            android:layout_marginBottom="20dp"
            android:gravity="center"/>

        <Button
            android:id="@+id/overlay_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View Request"
            android:textSize="12sp"
            android:textFontWeight="500"
            android:textColor="#161616"
            android:background="@drawable/button_background"
            android:paddingLeft="40dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:paddingRight="40dp" />
    </LinearLayout>

</FrameLayout>

    <!-- Round container for the image -->
    <FrameLayout
        android:id="@+id/roundContainer"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_centerInParent="true"
        android:layout_alignTop="@id/centerCard"
        android:layout_marginTop="-75dp"
        >

        <!-- Image overlay inside the round container -->
        <ImageView
            android:id="@+id/overlayImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@mipmap/ic_overlay_logo_foreground"
            android:scaleType="centerCrop"/>
    </FrameLayout>

</RelativeLayout>
