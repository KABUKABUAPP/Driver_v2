<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme - Force Light Mode -->
    <style name="Theme.KabukabuDriver" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <!-- Custom Splash Theme (No Native Splash) -->
    <style name="NoSplash" parent="Theme.AppCompat.NoActionBar">
        <!-- Background color rgba(22, 22, 22, 1) -->
        <item name="android:windowBackground">#161616</item>
        
        <!-- Make it full screen -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        
        <!-- Hide system bars -->
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        
        <!-- No animations -->
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>